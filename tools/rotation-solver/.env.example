# Copie para .env e preencha. Mesma URL/anon key já usadas pelo app web
# (apps/web/.env.local) — a anon key é segura (protegida por RLS), nunca
# coloque aqui a service_role key.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Opcional — se não preencher, buscar_dados.py pergunta no terminal a cada
# execução (não fica guardado em lugar nenhum além deste ficheiro, se você
# optar por preencher). NUNCA commitar o .env com isto preenchido.
TEAMBENCH_EMAIL=
TEAMBENCH_PASSWORD=
